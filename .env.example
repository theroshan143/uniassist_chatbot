# UniAssist Environment Configuration
# Copy this file to .env and fill in the values

# === LLM Provider (xAI Grok or Google Gemini via AI Studio) ===
# Option A: Google AI Studio (Free Gemini API key from https://aistudio.google.com/)
# XAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# XAI_API_KEY=AIzaSy...
# XAI_MODEL=gemini-1.5-flash

# Option B: xAI / Grok API
XAI_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4           # Will auto-detect best available if this model is unavailable

# === Admin Panel ===
ADMIN_PASSWORD=admin123     # Change this in production!

# === RAG Settings ===
SIMILARITY_THRESHOLD=0.75   # Maximum cosine distance (lower = more similar, <=0.75 is relevant)
TOP_K=5                     # Number of chunks to retrieve
CHUNK_SIZE=500              # Approximate tokens per chunk
CHUNK_OVERLAP=80            # Token overlap between chunks

# === Rate Limiting ===
RATE_LIMIT_PER_MIN=30       # Max requests per minute per IP

# === Demo Mode ===
# Set to true to run without an LLM API key (returns RAG passages only)
DEMO_MODE=false

# === Paths (defaults are fine for most setups) ===
CHROMA_PERSIST_DIR=./chroma_db
SQLITE_DB_PATH=./uniassist.db
KNOWLEDGE_BASE_DIR=./data/knowledge_base
